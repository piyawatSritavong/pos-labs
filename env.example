# PostgreSQL Configuration
POSTGRES_USER=posuser
POSTGRES_PASSWORD=pospass
POSTGRES_DB=poslabs
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=8080
ENV=development

# Database Connection (used by backend)
DB_HOST=postgres
DB_PORT=5432
DB_USER=posuser
DB_PASSWORD=pospass
DB_NAME=poslabs
DB_SSLMODE=disable

# JWT Configuration (add when implementing auth)
# JWT_SECRET=your-secret-key-here
