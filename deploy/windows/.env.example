ENV=production
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=posuser
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=poslabs
DB_SSLMODE=disable
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
STATIC_FILES_PATH=static

# POS_SECRET ต้องตรงกับค่าใน pos_setting.pos_secret และที่ build Flutter ด้วย
# --dart-define=POS_SECRET=<ค่าเดียวกัน>
# Migration 0010_real_seed_data.up.sql จะ UPDATE ค่าให้เป็น 'windows-pos-default-secret' อัตโนมัติ
# ถ้าเปลี่ยนค่าใหม่: (1) เปลี่ยน UPDATE statement ใน migration (2) rebuild Flutter ด้วยค่าใหม่
POS_SECRET=windows-pos-default-secret
