# PostgreSQL Configuration
POSTGRES_USER=posuser
POSTGRES_PASSWORD=pospass
POSTGRES_DB=poslabs
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=8080
ENV=development
APP_ENV=development
PORT=8080

# Database Connection (used by backend)
# DATABASE_URL has priority when set, for example Supabase:
# DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require
DB_HOST=postgres
DB_PORT=5432
DB_USER=posuser
DB_PASSWORD=pospass
DB_NAME=poslabs
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Cloud / startup controls
SERVE_STATIC=true
AUTO_MIGRATE=true
AUTO_SEED_CORE=true
AUTO_SEED_MOCK=true
AUTO_ENSURE_BARCODES=true
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# POS terminal secret. Must match Flutter --dart-define=POS_SECRET.
POS_SECRET=windows-pos-default-secret

# Hardware features should be false on cloud deployments.
RECEIPT_PRINTER_ENABLED=true
CASH_DRAWER_ENABLED=false

# JWT Configuration (add when implementing auth)
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRY=24h
