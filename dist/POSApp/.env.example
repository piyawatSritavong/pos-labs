ENV=production
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=posuser
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=poslabs
DB_SSLMODE=disable
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
STATIC_FILES_PATH=static

# POS_SECRET ต้องตรงกับค่าใน pos_setting.pos_secret และที่ build Flutter ด้วย
# --dart-define=POS_SECRET=<ค่าเดียวกัน>
# Migration 0010_real_seed_data.up.sql จะ UPDATE ค่าให้เป็น 'windows-pos-default-secret' อัตโนมัติ
# ถ้าเปลี่ยนค่าใหม่: (1) เปลี่ยน UPDATE statement ใน migration (2) rebuild Flutter ด้วยค่าใหม่
POS_SECRET=windows-pos-default-secret

# 80mm internal thermal receipt printer (Generic / Text Only driver).
# Production Windows test confirmed raw binary copy to LPT1 works:
#   cmd /c copy /b C:\POSApp\drawer.bin LPT1
RECEIPT_PRINTER_ENABLED=true
RECEIPT_PRINTER_PORT=LPT1
RECEIPT_PRINTER_NAME=POS80

# Production-safe default: print readable ASCII because this printer's
# Thai CP874 table renders incorrectly in Generic / Text Only mode.
# Use thai_cp874 only after the exact printer code table is verified.
RECEIPT_TEXT_MODE=ascii
RECEIPT_PRINT_MODE=ascii
RECEIPT_PRODUCT_NAME_MODE=receipt_name
RECEIPT_FORCE_ASCII=true

# Code page selector sent to the printer before any text (ESC t n).
# This MUST match the Thai code page the printer firmware supports, otherwise
# Thai characters render as Chinese / garbage. Try in this order:
#   21 — Star/Bixolon-style 80mm printers (default, most common in Thailand)
#   20 — alternative Thai code page on some Epson models
#   18 — Epson "Thai code 18" (CP874 / TIS-620)
#   16 — some older firmwares
# If text still looks wrong, contact your printer vendor for the correct
# "code page table for Thai" value, or check the printer's self-test page.
RECEIPT_CHARSET=21

# Cash drawer pulse through the receipt printer DK port. Hardware testing
# confirmed all four commands below opened the drawer; default to TEST 1.
CASH_DRAWER_ENABLED=true
CASH_DRAWER_BIN_PATH=C:\POSApp\drawer.bin
# Different printers/drawer ports use different pin values:
#   1B700019FA — ESC p 0 25 250 (DK1 / pin 0, short pulse)
#   1B700032FA — ESC p 0 50 250 (DK1 / pin 0, longer pulse)
#   1B700119FA — ESC p 1 25 250 (DK2 / pin 1, short pulse)
#   1B700132FA — ESC p 1 50 250 (DK2 / pin 1, longer pulse)
CASH_DRAWER_COMMAND=1B700019FA
